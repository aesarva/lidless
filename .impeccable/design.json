  "narrative": {
    "northStar": "The Studio Door",
    "overview": "The menu-bar panel is the door of a broadcast studio. While Lidless holds the Mac awake the ON AIR sign is lit; when it is not, the sign is dark glass with readable lettering. The panel is always dark studio black, with one cream plate and signal red spent only on being on air. Flat light, compact vertical column; the settings window stays native.",
    "keyCharacteristics": [
      "Always-dark panel, 320pt wide, 14pt continuous corners.",
      "Signal red means on air and nothing else.",
      "Cream plate is the only light surface; it holds measurements.",
      "State is never calmer than reality."
    ],
    "rules": [
      {
        "name": "The Spent Red Rule",
        "body": "Red appears only while on air (or as the standing heat red zone, shown faint when off). Off air an enabled switch is cream-grey and the battery stop line is plate ink.",
        "section": "colors"
      },
      {
        "name": "The Cream Plate Rule",
        "body": "Measurements live on the cream plate; the plate is the only light surface in the panel.",
        "section": "colors"
      },
      {
        "name": "The One Loud Face Rule",
        "body": "Unbounded belongs to the sign. Everything else is SF Pro.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do keep the panel dark and 320pt wide in every system appearance.",
      "Do spend signal red only on on-air state.",
      "Do use tabular digits for every changing number.",
      "Do pair every state with words; off air says so in text.",
      "Do keep the Settings window native and system-appearance."
    ],
    "donts": [
      "Don't set red on a control while off air.",
      "Don't use Unbounded outside the sign.",
      "Don't put coloured glows or extra light surfaces in the panel.",
      "Don't replace the duration row with a native segmented control (it breaks the panel width).",
      "Don't show a calm value (a timer, a full meter) when the data is absent; use an em dash and empty cells."
    ]
  }
